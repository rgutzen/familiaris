#!/usr/bin/env python3
"""pi-agent -- delegate a task to a specialised local model, at O(1) prompt cost.

WHY NOT AN EXTENSION. `@mjakl/pi-subagent` put 9,044 bytes (~1,918 tokens) into
EVERY parent session -- a 4.9KB tool schema plus a 4.2KB roster -- whether or not
anything delegated, and measured 0 calls in 20 sessions. Worse, it spawns the
child with `--append-system-prompt`, so the child inherits `~/.pi/agent/SYSTEM.md`
(the always-on payload) and the roster it cannot act on: 15,758 bytes before the
task. This script spawns the same child with `--system-prompt`, which REPLACES
that prompt, plus `-nc` to drop project context files. Measured floor for a
bash-only worker: 1,001 bytes. Read-only explorer: 3,425.

THE ROSTER IS ROUTED, NOT INJECTED -- the same rule as skills. The parent learns
one line ("delegate with `pi-agent`; `pi-agent --list` for the roster"), so the
roster costs nothing until it is wanted and adding the twentieth specialist costs
the parent exactly as much as the second: nothing.

WHY THE CHILD KEEPS EXTENSIONS BUT NOT LORE. `-ne` would be simpler, but it also
drops `@gotgenes/pi-permission-system` -- a bash-capable child with no boundary
enforcement is the wrong trade. Extensions cost 0 prompt bytes (measured), so
they stay. `LORE_DISABLED=1` is separate and necessary: the lore extension
re-registers every provider at its gateway, so a child without it does not reach
ollama at all (verified: no request arrives), and its memory DB would fill with
subagent chatter.

DELEGATION IS ONLY WORTH IT WHEN THE CHILD DISCARDS MORE THAN IT RETURNS. The
parent pays the returned summary; the child pays its own ~1-3.5KB floor plus what
it reads. Recon over many files wins; a single mechanical command does not -- the
parent already has `bash`.
"""
from __future__ import annotations

import argparse
import os
import pathlib
import subprocess
import sys
import uuid

# `lib/roots` says where the definitions are (R2a): the engine is generic
# code, and R3b moved the definitions out of the vault; the subject move of
# 2026-10-12 put them under `config/orchestration/`.
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
from lib import roots  # noqa: E402

DEFAULT_DIR = pathlib.Path(os.environ.get("PI_AGENT_DIR", roots.SUBAGENTS))
SESSION_DIR = pathlib.Path.home() / ".pi/agent/sessions/pi-agent"
# uuid5 in a fixed namespace: the same handle always resolves to the same child
# session, without a lookup table that could drift from the sessions on disk.
NS = uuid.UUID("6ba7b812-9dad-11d1-80b4-00c04fd430c8")


class Agent:
    """One `<name>.md`: YAML-ish frontmatter, then the system prompt body.

    Only four keys are read (`name`, `description`, `model`, `tools`); the file
    format is the one `@mjakl/pi-subagent` used, so definitions written for it
    still work. Unknown keys are ignored rather than rejected -- `sessionHint`
    and friends are prose for a roster this script does not print in full.
    """

    def __init__(self, path: pathlib.Path):
        text = path.read_text(encoding="utf-8")
        if not text.startswith("---"):
            raise ValueError(f"{path}: no frontmatter")
        _, front, body = text.split("---", 2)
        meta: dict[str, str] = {}
        key = None
        for line in front.splitlines():
            if line.strip() and not line.startswith((" ", "\t")) and ":" in line:
                key, _, val = line.partition(":")
                meta[key.strip()] = val.strip()
            elif key and line.strip():                 # folded continuation line
                meta[key] += " " + line.strip()
        self.path = path
        self.name = meta.get("name") or path.stem
        self.description = meta.get("description", "")
        self.model = meta.get("model") or ""
        self.tools = [t.strip() for t in meta.get("tools", "").split(",") if t.strip()]
        self.body = body.strip() + "\n"


def load_all() -> list[Agent]:
    if not DEFAULT_DIR.is_dir():
        return []
    out = []
    for p in sorted(DEFAULT_DIR.glob("*.md")):
        try:
            out.append(Agent(p))
        except ValueError as exc:                      # a broken file is named,
            print(f"pi-agent: skipping {exc}", file=sys.stderr)   # never dropped
    return out


def cmd_list(agents: list[Agent], verbose: bool) -> int:
    if not agents:
        print(f"pi-agent: no definitions in {DEFAULT_DIR}", file=sys.stderr)
        return 1
    for a in agents:
        first = a.description.split(". ")[0].rstrip(".")
        print(f"{a.name:12} {first if not verbose else a.description}")
        if verbose:
            print(f"{'':12} model={a.model or '(parent default)'} tools={','.join(a.tools) or 'all'}")
    return 0


def run(agent: Agent, task: str, cwd: str, timeout: float | None,
        model: str | None, session: str | None) -> int:
    prompt = SESSION_DIR / f"prompt-{agent.name}-{os.getpid()}.md"
    prompt.parent.mkdir(parents=True, exist_ok=True)
    prompt.write_text(agent.body, encoding="utf-8")
    cmd = ["pi", "-p", task,
           "--system-prompt", str(prompt),   # REPLACES SYSTEM.md -- the whole point
           "-nc",                            # no AGENTS.md/CLAUDE.md discovery
           "-ns",                            # no skills index
           "--no-approve"]
    if agent.tools:
        cmd += ["--tools", ",".join(agent.tools)]
    chosen = model or agent.model
    if chosen:
        cmd += ["--model", chosen]
    if session:
        cmd += ["--session-dir", str(SESSION_DIR),
                "--session-id", str(uuid.uuid5(NS, f"{agent.name}:{session}"))]
    else:
        cmd += ["--no-session"]
    env = dict(os.environ, LORE_DISABLED="1", PI_OFFLINE="1")
    try:
        proc = subprocess.run(cmd, cwd=cwd, env=env, timeout=timeout)
        return proc.returncode
    except subprocess.TimeoutExpired:
        print(f"pi-agent: {agent.name} exceeded {timeout}s", file=sys.stderr)
        return 124
    finally:
        prompt.unlink(missing_ok=True)


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="pi-agent", description="Delegate one task to a specialised local model.")
    ap.add_argument("agent", nargs="?", help="agent name (see --list)")
    ap.add_argument("task", nargs="?", help="the task, sent verbatim")
    ap.add_argument("--list", "-l", action="store_true", help="print the roster")
    ap.add_argument("--verbose", "-v", action="store_true", help="full roster detail")
    ap.add_argument("--cwd", default=os.getcwd())
    ap.add_argument("--timeout", type=float, default=900.0)
    ap.add_argument("--model", help="override the agent's model")
    ap.add_argument("--session", help="durable handle; omit for a fresh child")
    args = ap.parse_args()

    agents = load_all()
    if args.list or not args.agent:
        return cmd_list(agents, args.verbose)
    match = next((a for a in agents if a.name == args.agent), None)
    if match is None:
        print(f"pi-agent: no agent '{args.agent}' in {DEFAULT_DIR}; "
              f"known: {', '.join(a.name for a in agents) or '(none)'}", file=sys.stderr)
        return 2
    if not args.task:
        print("pi-agent: a task is required", file=sys.stderr)
        return 2
    return run(match, args.task, args.cwd, args.timeout, args.model, args.session)


if __name__ == "__main__":
    sys.exit(main())
