{
  "about": "The boundaries parity corpus (memory/knowledge/system/boundaries/boundaries.md §Parity corpus). One case per behaviour every judge must share; each judge's suite runs all of it. `{HOME}`, `{CWD}` (= {HOME}/06_SYSTEM), `{VAULT}` and `{VAULT_NAME}` are expanded by the runner -- the vault's name is assembled so this file greps clean. `rule` is the `models:` of the rule that decides the case; a judge that enforces only some model classes (pi-guard: local/remote) expects `allow` where another layer decides. `expected_fail` maps a judge to the reason it diverges today; it is the 'known weaker' gap as data, and removing an entry is the evidence it closed.",
  "tools": {
    "read": "a file read, {path}",
    "write": "a file write, {path}",
    "edit": "a file edit, {path}",
    "glob": "a glob, {pattern}",
    "grep": "a content search, {pattern, path}",
    "bash": "a shell command, {command}"
  },
  "cases": [
    {
      "label": "vault read",
      "model": "remote",
      "tool": "read",
      "args": {
        "path": "{VAULT}/n.md"
      },
      "expect": "deny",
      "rule": "all"
    },
    {
      "label": "vault write",
      "model": "remote",
      "tool": "write",
      "args": {
        "path": "{VAULT}/x.md"
      },
      "expect": "deny",
      "rule": "all"
    },
