        "opencode-session": ("familiar-memory", ["opencode-session"], "stage one opencode transcript --session=ID"),
        "hermes-session": ("familiar-memory", ["hermes-session"], "hook-facing: session_id on stdin"),
        "hermes-session-worker": ("familiar-memory", ["hermes-session-worker"], "the detached worker --session=ID"),
        "pointers": ("familiar-memory", ["pointers"], "which paths sessions touched"),
        "harness": ("familiar-context", ["harness"], "drive each harness once against a stub"),
