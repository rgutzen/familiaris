def usage(out=sys.stdout) -> int:
    out.write("usage: familiar <subject> <verb> [args]\n")
    for subject, verbs in ROUTES.items():
        out.write(f"\n{subject}\n")
        for verb, route in verbs.items():
            out.write(f"  {verb:<22}{route[-1]}\n")
    return 0


def resolve(argv):
    """argv -> (route, rest), or raise SystemExit with a message."""
    if not argv or argv[0] in ("-h", "--help", "help"):
        raise SystemExit(usage())
    subject = argv[0]
    if subject not in ROUTES:
        sys.stderr.write(f"familiar: unknown subject {subject!r}. Subjects: "
                         f"{', '.join(ROUTES)}\n")
        raise SystemExit(1)
    verbs = ROUTES[subject]
    if len(argv) == 1 or argv[1] in ("-h", "--help", "help"):
        # A subject with no verb is an incomplete command (exit 1); `--help`
        # asks for the list (exit 0). The old front door drew the same line.
        sys.stdout.write(f"usage: familiar {subject} <verb> [args]\n")
        for verb, route in verbs.items():
            sys.stdout.write(f"  {verb:<22}{route[-1]}\n")
        raise SystemExit(0 if len(argv) > 1 else 1)
    verb = argv[1]
    if verb not in verbs:
        sys.stderr.write(f"familiar: {subject} has no verb {verb!r}. Verbs: "
                         f"{', '.join(verbs)}\n")
        raise SystemExit(1)
    return verbs[verb], list(argv[2:])


def agents_dir() -> str:
    from lib import roots
    return os.environ.get("PAZRAS_MEMORY_DIR", str(roots.INSTALL / roots.MEMORY_REL))


def main(argv) -> int:
    route, rest = resolve(argv)
    kind, target, spec_attr, shape, _ = route
    if kind == "exec":
        # A shell back-end is exec'd: same process slot, no wrapper left waiting.
        path = os.path.join(HERE, target)
        os.execv(path, [path] + list(spec_attr) + rest)

    import importlib
    module_name, _, func_name = target.partition(":")
    module = importlib.import_module(module_name)
    fn = getattr(module, func_name)
    if shape == "argv2":                   # fn(argv, data root, memory root)
        from lib import roots
        return fn(rest, str(roots.data_root()), agents_dir())
    if not spec_attr:                      # the function parses its own flags
        return fn(rest)

    from lib import invocation, roots
    spec = getattr(module, spec_attr)
    try:
        inv = invocation.parse(rest, spec, str(roots.data_root()), agents_dir())
    except invocation.UsageError as exc:
        sys.stderr.write(f"[familiar] {exc}\n")
        return 1
    if inv.help:
        sys.stderr.write(f"  usage: {spec.usage}\n")
        return 0
    try:
        return fn(inv)
    except invocation.UsageError as exc:
        sys.stderr.write(f"[familiar] {exc}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
