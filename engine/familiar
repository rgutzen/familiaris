def usage(out=sys.stdout) -> int:
    out.write("usage: familiar <subject> <verb> [args]\n")
    for subject, verbs in ROUTES.items():
        out.write(f"\n{subject}\n")
        for verb, (_, _, text) in verbs.items():
            out.write(f"  {verb:<22}{text}\n")
    return 0


def resolve(argv):
    """argv -> (back-end, argv for it), or raise SystemExit with a message."""
    if not argv or argv[0] in ("-h", "--help", "help"):
        raise SystemExit(usage())
    subject = argv[0]
    if subject not in ROUTES:
        sys.stderr.write(f"familiar: unknown subject {subject!r}. Subjects: "
                         f"{', '.join(ROUTES)}\n")
        raise SystemExit(1)
    verbs = ROUTES[subject]
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        sys.stdout.write(f"familiar {subject} <verb>\n")
        for verb, (_, _, text) in verbs.items():
            sys.stdout.write(f"  {verb:<22}{text}\n")
        raise SystemExit(0 if len(argv) >= 2 else 1)
    verb = argv[1]
    if verb not in verbs:
        sys.stderr.write(f"familiar: {subject} has no verb {verb!r}. Verbs: "
                         f"{', '.join(verbs)}\n")
        raise SystemExit(1)
    backend, prefix, _ = verbs[verb]
    return backend, prefix + list(argv[2:])


def main(argv) -> int:
    backend, args = resolve(argv)
    kind, rel = BACKENDS[backend]
    path = os.path.join(HERE, rel)
    if kind == "exec":
        os.execv(path, [path] + args)
    import runpy
    sys.argv = [path] + args
    runpy.run_path(path, run_name="__main__")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
